[Unit]
Description=Simple Cat API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=catapi
Group=catapi
WorkingDirectory=/opt/cat-api
EnvironmentFile=/etc/cat-api/cat-api.env
ExecStart=/opt/cat-api/cat-api
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
