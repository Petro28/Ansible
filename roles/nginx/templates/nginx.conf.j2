user www-data;
worker_processes auto;
worker_cpu_affinity auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;

include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 768;
}

http {
    map $host $site_root {
        {{ nginx_cat_hostname }} {{ nginx_cat_root }};
        {{ nginx_dog_hostname }} {{ nginx_dog_root }};
    }

    map $host $api_backend {
        {{ nginx_cat_hostname }} http://{{ nginx_backend_host }}:{{ nginx_cat_api_port }};
        {{ nginx_dog_hostname }} http://{{ nginx_backend_host }}:{{ nginx_dog_api_port }};
    }

    sendfile on;
    tcp_nopush on;
    types_hash_max_size 2048;
    server_tokens off;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log /var/log/nginx/access.log;

    gzip on;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;
}
