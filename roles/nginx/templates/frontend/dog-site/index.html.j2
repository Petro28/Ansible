<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dog Generator</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <main class="card">
    <nav class="site-navigation" aria-label="Main navigation">
      <a href="https://{{ nginx_cat_hostname }}" class="nav-button active" aria-current="page">Cats</a>
    </nav>

    <h1>🐕 Dog Generator</h1>
    <p>Press the button to get a random dog.</p>

    <button id="generate" type="button">Generate Dog</button>

    <section id="dog" hidden aria-live="polite">
      <h2 id="name"></h2>
      <p id="description"></p>
    </section>

    <p id="error" role="alert" hidden></p>
  </main>

  <script src="/app.js"></script>
</body>
</html>
