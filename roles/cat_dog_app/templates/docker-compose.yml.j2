services:
  postgres:
    image: postgres:16
    container_name: postgres-cat-dog
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - {{ postgres_data_directory }}:/var/lib/postgresql/data
      - ./postgres/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  cat-api:
    build:
      context: ./cat-api
    container_name: cat-api
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD_URLENCODED}@postgres:5432/${POSTGRES_DB}
      API_ADDR: ":{{ cat_api_port }}"
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "{{ cat_api_bind_address }}:{{ cat_api_port }}:{{ cat_api_port }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:{{ cat_api_port }}/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  dog-api:
    build:
      context: ./dog-api
    container_name: dog-api
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD_URLENCODED}@postgres:5432/${POSTGRES_DB}
      API_ADDR: ":{{ dog_api_port }}"
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "{{ dog_api_bind_address }}:{{ dog_api_port }}:{{ dog_api_port }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:{{ dog_api_port }}/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s
